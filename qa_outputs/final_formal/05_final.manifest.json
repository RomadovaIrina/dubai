      "id": 2,
      "speaker": "SPEAKER_00",
      "speaker_method": "max_overlap",
      "speaker_overlap_s": 5.325,
      "translation": "And such a function, of course, adds us popularity and opportunities.",
      "tts": {
        "file": "/tmp/claude-0/-workspace-dub/d41e1d11-5eb1-434e-aa0a-b74c60d7f359/scratchpad/formal05/work/work_05/tts_u02.wav",
