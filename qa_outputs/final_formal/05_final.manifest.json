  "units": [
    {
      "asr_segment": 1,
      "start": 0.98,
      "end": 5.84,
      "text": "Давайте протестируем еще вот такой формат съемки видео",
      "words": 8,
      "id": 0,
      "speaker": "SPEAKER_00",
      "speaker_method": "max_overlap",
      "speaker_overlap_s": 3.143,
      "translation": "Let's test another such format for video shooting",
      "tts": {
        "file": "/tmp/claude-0/-workspace-dub/d41e1d11-5eb1-434e-aa0a-b74c60d7f359/scratchpad/formal05/work/work_05/tts_u00.wav",
